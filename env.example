# Copy this file to .env and fill in your key.
#   copy env.example .env
#
# Never commit .env to source control.
#
# Only ONE key is required to run the full agent (RL + LLM advisor):

# Anthropic — Claude handles vision analysis, strategic planning, AND tactical
# decisions in a single call. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

